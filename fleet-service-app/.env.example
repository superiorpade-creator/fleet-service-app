# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build absolute links inside generated PDFs, emails, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: company branding used on the completion PDF
COMPANY_NAME="Your Fleet Wash Co."
COMPANY_LOGO_URL=

# Text alerts for overdue accounts (see README "Service reminder text alerts")
# Twilio account (twilio.com) — Account SID and Auth Token from the console,
# and a Twilio phone number you've purchased/verified to send from.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550100

# Who receives the daily overdue-accounts text. Comma-separated, E.164 format.
ALERT_PHONE_NUMBERS=+15555550123

# Secret Vercel Cron uses to authenticate itself to /api/cron/service-reminders.
# Generate any random string (e.g. `openssl rand -hex 32`) and set the same
# value here and in your Vercel project's environment variables.
CRON_SECRET=
